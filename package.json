{
  "name": "infra",
  "version": "0.0.0-internal",
  "scripts": {
    "cf": "terraform -chdir=cf",
    "cf:init": "pnpm cf init -backend-config=../backend/backend.tfvars",
    "cf:apply": "pnpm cf apply -var-file local.tfvars",
    "cf:destroy": "pnpm cf destroy -var-file local.tfvars",
    "cf:tls": "terraform -chdir=cf-tls",
    "cf:tls:init": "pnpm cf:tls init -backend-config=../backend/backend.tfvars",
    "cf:tls:apply": "pnpm cf:tls apply -var-file local.tfvars",
    "cf:tls:destroy": "pnpm cf:tls destroy -var-file local.tfvars",
    "do": "terraform -chdir=do",
    "do:init": "pnpm do init -backend-config=../backend/backend.tfvars && mkdir -p ./do/outputs",
    "do:apply": "pnpm do apply -var-file local.tfvars",
    "do:destroy": "pnpm do destroy -var-file local.tfvars",
    "do:output:kubeconfig": "pnpm do output -raw kubeconfig > ./do/outputs/kubeconfig",
    "do:output:talosconfig": "pnpm do output -raw talosconfig > ./do/outputs/talosconfig",
    "talosctl": "talosctl --talosconfig ./do/outputs/talosconfig"
  },
  "license": "UNLICENSED"
}